const axios = require("axios");

module.exports.config = {
  name: "babu",
  version: "5.0.0",
  hasPermssion: 0,
  credits: "Thakur Sahab",
  description: "Sitara - Masti Wali",
  commandCategory: "ai",
  usages: "reply to message",
  cooldowns: 1
};

module.exports.handleEvent = async function({ api, event }) {
  const { threadID, messageID, senderID, body, messageReply } = event;

  if (!body) return;

  if (body.trim().toLowerCase() === "babu") {
    return api.sendMessage("Haan bolo kya hua? 😜 Sitara sun rahi hai", threadID, messageID);
  }

  const isReplyToBot = messageReply && messageReply.senderID == api.getCurrentUserID();
  if (!isReplyToBot) return;

  api.setMessageReaction("⌛", messageID, (err) => {}, true);

  global.babu = global.babu || {};
  const chatHistory = global.babu.chatHistory = global.babu.chatHistory || {};
  chatHistory[senderID] = chatHistory[senderID] || [];
  chatHistory[senderID].push(`User: ${body}`);
  if (chatHistory[senderID].length > 6) chatHistory[senderID].shift();
  const historyText = chatHistory[senderID].join("\n");

  const systemPrompt = `You are Sitara, a naughty, funny, roasting Indian girl in a group chat.
  Your Owner/Creator is Thakur Sahab.

  RULES - Follow strictly:
    1. DEFAULT BEHAVIOUR: Give funny, masti, roasting reply according to user's message. Use Hinglish (Roman Hindi + English). Do NOT add Thakur Sahab name in every reply.
    2. SPECIAL CONDITION: ONLY if user asks "tumhe kisne banaya", "owner kon hai", "boss kon hai", "creator kon", "tumhara malik kon hai", then you MUST reply: "Mujhe mere Thakur Sahab ne banaya hai 👑". Otherwise never say owner name.
    3. Keep reply short 1-2 lines.
    4. Use emojis and be savage/funny.
    5. Never say you are Meta AI or Pollinations.

  Chat History:
  ${historyText}
  Latest: ${body}`;

  try {
    const res = await axios.get(`https://text.pollinations.ai/${encodeURIComponent(systemPrompt)}?model=openai`);
    let botReply = res.data.trim().replace(/^(babu:|AI:|Sitara:)/i, "").trim();

    api.setMessageReaction("✅", messageID, (err) => {}, true);
    chatHistory[senderID].push(`Sitara: ${botReply}`);
    return api.sendMessage(botReply, threadID, messageID);
  } catch (err) {
    console.error(err);
    api.setMessageReaction("❌", messageID, (err) => {}, true);
  }
};

module.exports.run = async function({ api, event }) {
  return api.sendMessage("Sitara se baat karne ke liye uske msg pe reply karo 😜", event.threadID, event.messageID);
};
