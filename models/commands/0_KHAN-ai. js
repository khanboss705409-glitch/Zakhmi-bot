module.exports = {
  config: {
    name: "babu",
    version: "6.0",
    author: "Thakur Sahab",
    role: 0,
    shortDescription: "No Prefix Sitara",
    longDescription: "Babu bolte hi on",
    category: "no prefix",
    guide: "{pn}"
  },

  onStart: async function({ api, event }) {
    return api.sendMessage("Haan bolo jaanu 😜 Sitara sun rahi hai, ab bolo kya baat hai?", event.threadID, event.messageID);
  },

  onChat: async function({ api, event }) {
    const axios = require("axios");
    const body = event.body? event.body.toLowerCase() : "";

    // Agar koi "babu" bole
    if (body === "babu" || body.startsWith("babu ")) {
      return api.sendMessage("Haan bolo kya hua? 😜 Sitara sun rahi hai, mere msg ka reply karo", event.threadID, event.messageID);
    }

    // Agar bot ke msg pe reply kare
    if (event.messageReply && event.messageReply.senderID == api.getCurrentUserID()) {
      const prompt = event.body;
      try {
        const res = await axios.post("https://text.pollinations.ai/openai", {
          model: "openai",
          messages: [
            { role: "system", content: "You are Sitara, a naughty funny Indian girl. Owner is Thakur Sahab. Reply in Hinglish 1-2 lines, savage funny with emoji. If user asks owner/creator/banaya kisne then say 'Mujhe mere Thakur Sahab ne banaya hai 👑' else never say owner name." },
            { role: "user", content: prompt }
          ]
        });
        return api.sendMessage(res.data.choices[0].message.content, event.threadID, event.messageID);
      } catch (e) {
        return api.sendMessage("Arey network atak gaya jaanu, phir se bolo 😜", event.threadID, event.messageID);
      }
    }
  }
};
